APP_HOST=0.0.0.0
APP_PORT=8000
DEFAULT_MODE=hybrid
LOCAL_LLM_PROVIDER=ollama
LOCAL_LLM_MODEL=mistral:7b-instruct
OLLAMA_BASE_URL=http://host.docker.internal:11434
CLOUD_PROVIDER=openai
CLOUD_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
TAVILY_API_KEY=
ENABLE_PRESIDIO=false
ENABLE_WEB_SEARCH=false
SESSION_TTL_MINUTES=60
MAX_OUTBOUND_PROMPT_CHARS=16000
BLOCK_CLOUD_ON_RESIDUAL_RISK=true
MAX_DIRECTORY_FILES=25
API_AUTH_ENABLED=true
API_AUTH_TOKEN=replace-me
API_USER_TOKEN=replace-me-user
API_ADMIN_TOKEN=replace-me-admin
AUDIT_SNAPSHOTS_ENABLED=true
AUDIT_SNAPSHOTS_DIR=.audit
AUDIT_ENCRYPTION_KEY=replace-with-fernet-key
PRIVACY_LOGGING_ENABLED=true
PRIVACY_LOG_LEVEL=INFO
